{
  "name": "@livediagram/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --inspector-port 9232 --var AI_ALLOWED_ORIGINS:",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "node scripts/gen-openapi-schemas.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage"
  },
  "dependencies": {
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/diagram-lint": "workspace:*",
    "@livediagram/document": "workspace:*",
    "@livediagram/document-views": "workspace:*",
    "@livediagram/edit-operations": "workspace:*",
    "@livediagram/icons": "workspace:*",
    "@liveworkspace/render-png": "workspace:*",
    "@livediagram/templates": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:*",
    "@liveworkspace/settings": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@livediagram/oxlint-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@liveworkspace/community-service": "workspace:*",
    "@liveworkspace/index-service": "workspace:*",
    "@liveworkspace/media-service": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
