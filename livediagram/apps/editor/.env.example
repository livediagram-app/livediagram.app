# Live app environment variables.
#
# Anything prefixed `NEXT_PUBLIC_` is baked into the static export at
# build time and shipped to the browser. Everything else is build-only.
# Per spec 06 the repo is public, so never put secrets in NEXT_PUBLIC_
# variables.

# Where the live app calls the API. In production (Cloudflare) the
# router stitches the API onto the same hostname under `/api/*`, so
# leaving this unset is correct.
#
# For local development you'll want to override this:
#
# - Point at the STAGING api (its own database, safe to experiment
#   against — docs/specs/016-platform/staging-environment.md). Prefer this over production:
#     NEXT_PUBLIC_API_BASE=https://staging.livediagram.app/api
#
# - Point at the production api. This reads and WRITES the real
#   database that holds people's diagrams, so reach for staging above
#   unless you specifically need production data:
#     NEXT_PUBLIC_API_BASE=https://www.livediagram.app/api
#
# - Point at a local `wrangler dev` of @livediagram/api:
#     NEXT_PUBLIC_API_BASE=http://localhost:8687/api
#
# Copy this file to `.env.local` and edit. `.env.local` is gitignored.
NEXT_PUBLIC_API_BASE=

# Anonymous, first-party usage telemetry switch (docs/specs/017-telemetry/telemetry.md). When set to
# the literal string "true", `track(category, action, type?)` calls in
# the editor buffer events and POST them to the liveworkspace telemetry
# service (NEXT_PUBLIC_TELEMETRY_URL below). Anything
# else (including unset) makes `track()` a no-op so nothing leaves the
# browser. Default is OFF: forks that don't want a usage
# dashboard get full silence without doing anything. Pair this with
# `TELEMETRY_ENABLED=true` on the api worker (the authoritative
# server-side gate) to actually turn the system on end-to-end. Users
# also have a per-device opt-out toggle in the Settings dialog
# (docs/specs/007-editor/user-preferences.md `telemetryEnabled`) that overrides this when off.
NEXT_PUBLIC_TELEMETRY_ENABLED=

# The liveworkspace telemetry service the events go to (liveworkspace/docs/telemetry.md). Unset means
# production's, https://liveworkspace.app/api/telemetry. Local development, against the service running
# with `pnpm --filter @liveworkspace/telemetry-service dev`:
#     NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8790/api/telemetry
NEXT_PUBLIC_TELEMETRY_URL=

# The liveworkspace Community service (liveworkspace/docs/community.md) the Community reads come from:
# the featured posts and the publish dialog's popular tags. Unset means production's,
# https://liveworkspace.app/api/community. Local development, against
# `pnpm --filter @liveworkspace/community-service dev`:
#     NEXT_PUBLIC_COMMUNITY_API=http://localhost:8791/api/community
NEXT_PUBLIC_COMMUNITY_API=

# Origin of the MCP server (docs/specs/015-api/mcp-server.md), used by the live app to show the
# connect-an-AI-tool URLs and link out to it. Optional: leaving this
# unset defaults to the hosted `https://mcp.livediagram.app`
# (apps/editor/lib/mcp-config.ts). An MCP worker on a different host
# (staging, say) is set here (it must match the mcp worker's
# own host + its CONSENT_BASE_URL pointing back at this live app). Safe
# to ship in client bundles.
NEXT_PUBLIC_MCP_ORIGIN=

# The live build id (docs/specs/016-platform/stale-builds.md): the deploy's commit, matched by the
# api worker's BUILD_ID. Set by the deploy workflow; unset (local dev) turns stale-build detection
# off. Safe to ship in client bundles.
NEXT_PUBLIC_BUILD_ID=

# Where people manage their teams and API tokens: liveworkspace.app, which runs both for every app
# (liveworkspace/docs/accounts.md). Empty means https://liveworkspace.app; a staging build points at
# https://staging.liveworkspace.app, and local development at the liveworkspace site's dev server.
# Not a secret.
NEXT_PUBLIC_ACCOUNTS_SITE_URL=
