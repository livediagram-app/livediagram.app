{
  "name": "@livediagram/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --inspector-port 9230",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && vitest-budgets",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage"
  },
  "dependencies": {
    "@livediagram/agent-verbs": "workspace:*",
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/diagram-lint": "workspace:*",
    "@livediagram/document": "workspace:*",
    "@livediagram/templates": "workspace:*",
    "@liveworkspace/api-client": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/mcp-kit": "workspace:*",
    "@liveworkspace/render-png": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
