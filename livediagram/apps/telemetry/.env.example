# Telemetry dashboard environment variables.
#
# This app is a static export (see docs/specs/017-telemetry/telemetry.md). Anything prefixed
# NEXT_PUBLIC_ is baked into the build and shipped to the browser;
# per docs/specs/002-project-scope/secrets-policy.md the repo is public, so never put secrets here.

# Where the dashboard fetches GET /api/telemetry/summary from. In
# production the router stitches the api worker onto the same hostname
# under `/api/*`, so leaving this unset is correct (the page falls back
# to the origin-relative '/api', which the router rewrites).
#
# For local development you'll want to override this, otherwise the
# fetch hits the Next dev server (3003) and 404s. Three targets:
#
# - Point at a local `wrangler dev` of @livediagram/api (recommended):
#     NEXT_PUBLIC_API_BASE=http://localhost:8787/api
#
# - Point at the STAGING api, which serves staging's own events
#   (docs/specs/016-platform/staging-environment.md) — a real dataset to render against without touching
#   production's published numbers:
#     NEXT_PUBLIC_API_BASE=https://staging.livediagram.app/api
#
# - Point at the production api (reads production telemetry):
#     NEXT_PUBLIC_API_BASE=https://www.livediagram.app/api
#
# Copy this file to `.env.local` and edit. `.env.local` is gitignored.
NEXT_PUBLIC_API_BASE=

# Anonymous, first-party usage telemetry switch (docs/specs/017-telemetry/telemetry.md). The dashboard's
# only event is its own page view (docs/specs/017-telemetry/page-view-telemetry.md); its DATA is gated by the api
# worker's TELEMETRY_ENABLED instead. When set to the literal string "true"
# the page view is POSTed to `/api/events`; anything else (including unset)
# sends nothing. Self-host default is OFF.
NEXT_PUBLIC_TELEMETRY_ENABLED=
