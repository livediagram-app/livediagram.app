{
  "name": "@livediagram/document",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./infra-code": "./src/infra-code/index.ts",
    "./infra-sources": "./src/infra-code/record.ts",
    "./automations": "./src/automations/index.ts"
  },
  "dependencies": {
    "@liveworkspace/automations": "workspace:^",
    "@liveworkspace/element-model": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/model-core": "workspace:*",
    "js-yaml": "^5.5.0",
    "perfect-freehand": "^1.2.3",
    "smol-toml": "^1.9.1"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "stroke-points": "node --import ../../../scripts/ts-source-hooks.mjs scripts/expand-stroke-points.ts",
    "test:coverage": "vitest run --coverage && vitest-budgets",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
