{
  "name": "@livehuddle/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3502",
    "dev:webpack": "node ../../scripts/next-dev.mjs --port 3502 --webpack",
    "build": "next build && node scripts/asset-size-gate.mjs out",
    "build:signed-in": "node scripts/build-signed-in.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=sites",
    "test:e2e:smoke": "playwright test --project=chromium",
    "test:e2e:sites": "playwright test --project=sites",
    "perf:canvas": "E2E_PERF=1 playwright test --project=perf --reporter=line",
    "test:e2e:signed-in": "E2E_SIGNED_IN=1 playwright test --project=signed-in",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-dev .next-analyze out node_modules .turbo coverage",
    "icons:sheet": "vitest run --config scripts/icon-sheet/vitest.config.ts && node scripts/icon-sheet/shoot.mjs",
    "icons:brand": "node scripts/brand-icons/render.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@livehuddle/api-schema": "workspace:*",
    "@livehuddle/document": "workspace:*",
    "@livehuddle/document-views": "workspace:*",
    "@livehuddle/help-registry": "workspace:*",
    "@livehuddle/telemetry-client": "workspace:*",
    "@livehuddle/template-previews": "workspace:*",
    "@livehuddle/templates": "workspace:*",
    "@livehuddle/ui": "workspace:*",
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/avatar": "workspace:*",
    "@liveworkspace/community-ui": "workspace:*",
    "@liveworkspace/explorer": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:*",
    "@liveworkspace/migration": "workspace:*",
    "@liveworkspace/model-core": "workspace:*",
    "@liveworkspace/settings": "workspace:*",
    "@liveworkspace/settings-ui": "workspace:*",
    "@liveworkspace/sites": "workspace:*",
    "@liveworkspace/style-guards": "workspace:*",
    "@liveworkspace/telemetry-client": "workspace:*",
    "@liveworkspace/workbench": "workspace:*",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@liveworkspace/next-config": "workspace:*",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/source-ast": "workspace:*",
    "@livehuddle/tailwind-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
