# Community app environment variables.
#
# This app is a static export (docs/specs/025-community/community.md). Anything prefixed NEXT_PUBLIC_
# is baked into the build and shipped to the browser; per docs/specs/002-project-scope/secrets-policy.md
# the repo is public, so never put secrets here.

# Where My Shares (`/api/community/mine`) and the card images (`/api/share/<code>/image.svg`) come
# from. In production the router stitches the api worker onto the same hostname under `/api/*`, so
# leaving this unset is correct (it falls back to the origin-relative '/api', which the router rewrites).
#
# For local development point it at a `wrangler dev` of @livehuddle/api, otherwise the fetches hit
# the Next dev server (3005) and 404:
#     NEXT_PUBLIC_API_BASE=http://localhost:9087/api
#
# Copy this file to `.env.local` and edit. `.env.local` is gitignored.
NEXT_PUBLIC_API_BASE=

# The liveworkspace Community service the gallery, posts, likes and reports come from
# (liveworkspace/docs/specs/007-community/community.md). Unset means liveworkspace.app's as seen from the page: production's,
# staging's from a staging app, and on a dev server the local site's (localhost:3000), which forwards it.
# To talk to the service directly, running with `pnpm --filter @liveworkspace/community-service dev`:
#     NEXT_PUBLIC_COMMUNITY_API=http://localhost:8791/api/community
NEXT_PUBLIC_COMMUNITY_API=

# Anonymous, first-party usage telemetry switch (docs/specs/017-telemetry/telemetry.md), mirroring
# the help centre. When set to the literal string "true" the app's `track()` buffers events and
# POSTs them to the liveworkspace telemetry service; anything else (including unset) sends nothing.
# Default is OFF.
NEXT_PUBLIC_TELEMETRY_ENABLED=

# The liveworkspace telemetry service the events go to (liveworkspace/docs/specs/008-telemetry/telemetry.md). Unset means
# production's, https://www.liveworkspace.app/api/telemetry. Local development, against the service running
# with `pnpm --filter @liveworkspace/telemetry-service dev`:
#     NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8790/api/telemetry
NEXT_PUBLIC_TELEMETRY_URL=
