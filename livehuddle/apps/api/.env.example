# API worker environment variables (docs/specs/002-project-scope/secrets-policy.md).
#
# This worker runs on Cloudflare Workers, not Node. Local dev reads
# these from `apps/api/.dev.vars` (gitignored, see wrangler docs);
# production reads them from `wrangler.toml` [vars] for plain
# strings, and from `wrangler secret put` for secrets. This file is
# a copy-paste reference for what the worker consults at runtime,
# committed to the repo so contributors have one place to look.
#
# Per docs/specs/002-project-scope/secrets-policy.md the repo is public, so never put real secret values
# in this file: hex / token shapes are placeholders only.

# Sign-in through the liveworkspace accounts Worker
# (docs/specs/014-identity/auth-and-guest-access.md). Guests are
# liveworkspace's too: their guest tokens are checked the same way. Unset
# ACCOUNTS_URL or API_RESOURCE = no caller has an identity, and only
# share-link visitors are served. Drop into .dev.vars for local dev; provision
# each via `wrangler secret put <NAME>` in production (wrangler.toml lists them).
#
# The worker checks each access or guest token locally against the accounts Worker's
# published keys (${ACCOUNTS_URL}/api/auth/jwks), its issuer
# (${ACCOUNTS_URL}/api/auth) and this API's own audience (API_RESOURCE), so a
# token minted for another liveworkspace app is refused. Teams
# (docs/specs/013-workspace/teams.md) reads the token's verified `email` claim
# to auto-connect pending invites.
# ACCOUNTS_URL=https://accounts.example
# API_RESOURCE=https://livediagram.example/api
# ACCOUNTS_CLIENT_ID=replace-with-client-id
# ACCOUNTS_CLIENT_SECRET=replace-with-client-secret
#
# Local dev only: the origin the browser comes back to after signing in,
# when the api runs behind the router (pnpm dev). The accounts Worker must
# list ${AUTH_ORIGIN}/api/auth/callback as a redirect URI.
# AUTH_ORIGIN=http://localhost:3100

# Anonymous telemetry (docs/specs/017-telemetry/telemetry.md), sent to the liveworkspace telemetry
# service (liveworkspace/docs/specs/008-telemetry/telemetry.md). Only the literal string "true" enables it. Unset /
# "false" / anything else sends nothing: the relay route answers 204 and passes nothing on, so OSS
# a deployment stays silent by default.
# TELEMETRY_ENABLED=true

# Where the service is. Unset means production's, https://www.liveworkspace.app/api/telemetry.
# TELEMETRY_URL=http://localhost:8790/api/telemetry

# livediagram's secret on the telemetry service, sent as X-Telemetry-Key: it proves a batch with no
# Origin is livediagram's own. The SAME value goes on the mcp worker and on the service as
# TELEMETRY_KEY_LIVEDIAGRAM (the local service's .dev.vars.example uses dev-livediagram-key).
# Unset = nothing is sent, so a deployment can ignore this entirely.
# TELEMETRY_KEY=dev-livediagram-key

# The Community's off switch (docs/specs/025-community/community.md "Turning the Community off"). Set to false (or 0,
# off) to close every Community route and link and hide the Community from every app, without redeploying them:
# `wrangler secret put COMMUNITY_ENABLED` or a dashboard variable. Unset leaves it on.
# COMMUNITY_ENABLED=false

# The liveworkspace Community service (liveworkspace/docs/specs/007-community/community.md), run locally with `pnpm dev` in
# liveworkspace/apps/community (port 8791). Without the key the api reports the Community off, and the Community
# page sends every visitor to the home page. The same value is the service's COMMUNITY_KEY_LIVEDIAGRAM.
# COMMUNITY_KEY=dev-livediagram-community-key
# COMMUNITY_URL=http://localhost:8791/api/community

# The sticky-note photo reader (docs/specs/021-event-storming/note-reader.md). The PROVIDER is
# inferred from which key you set — a key is provider-specific, so its name says
# whose it is. Google outranks the generic key. No key = the photo reader hides
# (capabilities reports aiEnabled:false, the route answers 503).
#
# Google AI Studio:
# GOOGLE_AI_STUDIO_API_KEY=...
#
# Anything else that speaks the OpenAI wire (Mistral, OpenRouter, a local
# llama.cpp or Ollama) — needs the base URL and the model as well:
# AI_API_KEY=not-used-but-required
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_VISION_MODEL=whatever-you-loaded
#
# Optional on Google:
# AI_VISION_MODEL=...   the reader's model (default gemini-2.5-flash-lite, which
#                       reads handwriting well and costs little).

# Optional spend-DoS defences on the reader. Both default to "off" so OSS
# other deployments keep the historical open behaviour.
# Hosted livediagram.app sets the origin allow-list.
# AI_ALLOWED_ORIGINS=https://livediagram.app,http://localhost:3102
# AI_REQUIRE_SIGN_IN=true

# Images live in liveworkspace's media service (liveworkspace/docs/specs/006-media/media.md), which keeps every app's uploads and
# their caps. livediagram's secret on it, the same value as the service's MEDIA_KEY_LIVEDIAGRAM (its local
# .dev.vars.example uses dev-livediagram-media-key). Unset = no images: the image endpoints answer 503.
# MEDIA_KEY=dev-livediagram-media-key
# Where the service is. Unset means production's, https://www.liveworkspace.app/api/media.
# MEDIA_URL=http://localhost:8792/api/media

# liveworkspace's index (liveworkspace/docs/specs/004-index/one-explorer.md): where every canvas is filed, its sharing, Trash and
# Timeline. Production's is https://www.liveworkspace.app (hosted-vars.json); a local index runs on :8793. INDEX_KEY is
# livediagram's secret there, the same value as the index's INDEX_KEY_LIVEDIAGRAM.
# INDEX_ORIGIN=http://127.0.0.1:8793
# INDEX_KEY=dev-livediagram-index-key

# liveworkspace's Drive mirror (liveworkspace/docs/specs/005-drive/drive.md "Contracts > The apps"): livediagram's secret on it, the
# same value as the service's DRIVE_KEY_LIVEDIAGRAM. It opens the internal export door (`format=file`) and the import
# door, nothing else. Unset = the mirror cannot export or import canvases.
# DRIVE_KEY=dev-livediagram-drive-key

# Transactional + lifecycle email goes out through Cloudflare Email Service's `send_email` binding `EMAIL`
# (docs/specs/014-identity/transactional-email.md, liveworkspace/docs/specs/003-accounts/email.md), declared in wrangler.toml.
# There is no API key to set here: `wrangler dev` simulates the binding, printing each email and saving it to a
# file, so nothing is sent locally. Without the binding no email is ever sent and the email_lifecycle table is
# never touched. EMAIL_FROM is set in wrangler.toml's [vars]; APP_BASE_URL is an optional override for the links.
# APP_BASE_URL=https://livediagram.app

# The live build id (docs/specs/016-platform/stale-builds.md): the deploy's commit, the same value
# as the editor build's NEXT_PUBLIC_BUILD_ID. The deploy workflow sets both; unset leaves it off
# the server release signal (an open editor then never treats itself as stale).
# BUILD_ID=

# The migration from the old livediagram.app (docs/migration.md "The apps' migration door"): the migrate tool's key on
# PUT /api/internal/items/:id/migration and PUT /api/internal/people/:id/migration (a person's shape libraries), which
# it opens and nothing else. Set only while the migration runs, then removed. Unset = the item door takes the index's
# INDEX_KEY alone, and the person door is a 404.
# MIGRATION_KEY=dev-livediagram-migration-key
