{
  "name": "@livehuddle/router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "dev": "wrangler dev --env local --port 3500 --inspector-port 9631",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@livehuddle/api-schema": "workspace:*",
    "@livehuddle/help-registry": "workspace:*",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@liveworkspace/sites": "workspace:*"
  }
}
