{
  "name": "@livediagram/router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --env local --port 3000 --inspector-port 9231",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/help-registry": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
