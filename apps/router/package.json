{
  "name": "@livediagram/router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "dev": "wrangler dev --env local --port 3000 --inspector-port 9231",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/help-registry": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.1"
  }
}
