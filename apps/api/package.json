{
  "name": "@livediagram/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var AI_ALLOWED_ORIGINS:",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "node scripts/gen-openapi-schemas.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage",
    "db:migrate:local": "wrangler d1 migrations apply livediagram --local",
    "db:migrate:remote": "wrangler d1 migrations apply livediagram --remote"
  },
  "dependencies": {
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/diagram": "workspace:*",
    "@livediagram/icons": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@types/node": "^26.6.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
