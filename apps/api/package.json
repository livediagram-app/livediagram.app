{
  "name": "@livediagram/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "node scripts/gen-openapi-schemas.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage",
    "db:migrate:local": "wrangler d1 migrations apply livediagram --local",
    "db:migrate:remote": "wrangler d1 migrations apply livediagram --remote"
  },
  "dependencies": {
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/diagram": "workspace:*",
    "@livediagram/icons": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  }
}
