{
  "name": "@livediagram/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/main.mjs",
    "dev": "node --watch dist/main.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@livediagram/api": "workspace:*",
    "@livediagram/runtime": "workspace:*",
    "better-auth": "^1.7.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
