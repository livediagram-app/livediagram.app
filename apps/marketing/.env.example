# Marketing site environment variables.
#
# This app is a static export. Anything prefixed NEXT_PUBLIC_ is baked into
# the build and shipped to the browser; per spec/06 the repo is public, so
# never put secrets here.

# Where the page-view counter (spec/150) sends its events. In production the
# router stitches the api worker onto the same hostname under `/api/*`, so
# leaving this unset is correct (it falls back to the origin-relative '/api').
# For local development point it at a `wrangler dev` of @livediagram/api:
#     NEXT_PUBLIC_API_BASE=http://localhost:8787/api
NEXT_PUBLIC_API_BASE=

# Anonymous, first-party usage telemetry switch (spec/22). The marketing
# site's ONLY event is the page view (spec/150). When set to the literal
# string "true" it is POSTed to `/api/events`; anything else (including
# unset) sends nothing. Self-host default is OFF. Pair with
# `TELEMETRY_ENABLED=true` on the api worker, the authoritative gate.
NEXT_PUBLIC_TELEMETRY_ENABLED=
