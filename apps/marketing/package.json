{
  "name": "@livediagram/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3001",
    "build": "node ../../packages/licences/scripts/generate.ts --out . && next build && node ../../packages/licences/scripts/verify.ts .",
    "licences": "node ../../packages/licences/scripts/generate.ts --out .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-analyze out generated public/licences node_modules .turbo"
  },
  "dependencies": {
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/icons": "workspace:*",
    "@livediagram/telemetry-client": "workspace:*",
    "@livediagram/template-previews": "workspace:*",
    "@livediagram/templates": "workspace:*",
    "@livediagram/ui": "workspace:*",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@livediagram/document": "workspace:*",
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/licences": "workspace:*",
    "@livediagram/tailwind-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
