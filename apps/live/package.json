{
  "name": "@livediagram/live",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3002",
    "dev:webpack": "node ../../scripts/next-dev.mjs --port 3002 --webpack",
    "build": "next build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-dev out node_modules .turbo coverage"
  },
  "dependencies": {
    "@clerk/react": "^6.15.1",
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/diagram": "workspace:*",
    "@livediagram/help-registry": "workspace:*",
    "@livediagram/icons": "workspace:*",
    "@livediagram/telemetry-client": "workspace:*",
    "@livediagram/templates": "workspace:*",
    "@livediagram/ui": "workspace:*",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/tailwind-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
