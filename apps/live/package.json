{
  "name": "@livediagram/live",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3002",
    "dev:webpack": "node ../../scripts/next-dev.mjs --port 3002 --webpack",
    "build": "next build && node scripts/asset-size-gate.mjs out",
    "build:clerk-stub": "node scripts/build-clerk-stub.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=sites",
    "test:e2e:smoke": "playwright test --project=chromium",
    "test:e2e:sites": "playwright test --project=sites",
    "perf:canvas": "E2E_PERF=1 playwright test --project=perf --reporter=line",
    "test:e2e:clerk-stub": "E2E_CLERK_STUB=1 playwright test --project=clerk-stub",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-dev .next-analyze out node_modules .turbo coverage",
    "icons:sheet": "vitest run --config scripts/icon-sheet/vitest.config.ts && node scripts/icon-sheet/shoot.mjs",
    "icons:brand": "node scripts/brand-icons/render.mjs",
    "test:e2e:drive": "NEXT_PUBLIC_E2E_AUTH=1 NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789012-e2e.apps.googleusercontent.com NEXT_PUBLIC_GOOGLE_API_KEY=e2e-picker-key next build && E2E_DRIVE=1 playwright test --project=drive",
    "test:e2e:drive-shots": "NEXT_PUBLIC_E2E_AUTH=1 NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789012-e2e.apps.googleusercontent.com NEXT_PUBLIC_GOOGLE_API_KEY=e2e-picker-key next build && E2E_DRIVE=1 playwright test --project=drive-shots"
  },
  "dependencies": {
    "@clerk/react": "^6.17.4",
    "@huggingface/transformers": "^3.8.1",
    "@jsquash/webp": "1.5.0",
    "@livediagram/api-schema": "workspace:*",
    "@livediagram/document": "workspace:*",
    "@livediagram/explorer-lens": "workspace:*",
    "@livediagram/help-registry": "workspace:*",
    "@livediagram/icons": "workspace:*",
    "@livediagram/sticky-model": "workspace:*",
    "@livediagram/sticky-vision": "workspace:*",
    "@livediagram/telemetry-client": "workspace:*",
    "@livediagram/template-previews": "workspace:*",
    "@livediagram/templates": "workspace:*",
    "@livediagram/ui": "workspace:*",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "next": "^16.3.8",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/fake-google": "workspace:*",
    "@livediagram/tailwind-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
