{
  "name": "@liveplanner/live",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3102",
    "dev:webpack": "node ../../scripts/next-dev.mjs --port 3102 --webpack",
    "build": "next build && node scripts/asset-size-gate.mjs out",
    "build:clerk-stub": "node scripts/build-clerk-stub.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=sites",
    "test:e2e:smoke": "playwright test --project=chromium",
    "test:e2e:sites": "playwright test --project=sites",
    "perf:canvas": "E2E_PERF=1 playwright test --project=perf --reporter=line",
    "test:e2e:clerk-stub": "E2E_CLERK_STUB=1 playwright test --project=clerk-stub",
    "test:e2e:armed": "E2E_GUEST_SIG_ENFORCE=1 playwright test --project=armed",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-dev .next-analyze out node_modules .turbo coverage",
    "icons:sheet": "vitest run --config scripts/icon-sheet/vitest.config.ts && node scripts/icon-sheet/shoot.mjs",
    "icons:brand": "node scripts/brand-icons/render.mjs",
    "test:e2e:workbench": "NEXT_PUBLIC_E2E_AUTH=1 next build && E2E_WORKBENCH=1 playwright test --project=workbench"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@huggingface/transformers": "^3.8.1",
    "@jsquash/webp": "1.5.0",
    "@liveplanner/api-schema": "workspace:*",
    "@liveplanner/document": "workspace:*",
    "@liveplanner/document-views": "workspace:*",
    "@liveplanner/explorer-lens": "workspace:*",
    "@liveplanner/forms": "workspace:*",
    "@liveplanner/help-registry": "workspace:*",
    "@liveplanner/icons": "workspace:*",
    "@liveplanner/items": "workspace:*",
    "@liveplanner/plan-art": "workspace:*",
    "@liveplanner/sheets": "workspace:*",
    "@liveplanner/sticky-model": "workspace:*",
    "@liveplanner/sticky-vision": "workspace:*",
    "@liveplanner/telemetry-client": "workspace:*",
    "@liveplanner/template-previews": "workspace:*",
    "@liveplanner/templates": "workspace:*",
    "@liveplanner/ui": "workspace:*",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "gifenc": "1.0.3",
    "next": "^16.4.1",
    "polygon-clipping": "0.15.7",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@liveplanner/next-config": "workspace:*",
    "@liveplanner/oxlint-config": "workspace:*",
    "@liveplanner/source-ast": "workspace:*",
    "@liveplanner/tailwind-config": "workspace:*",
    "@liveplanner/vitest-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
