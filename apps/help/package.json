    "@livediagram/telemetry-client": "workspace:*",
    "@livediagram/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.3",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/tailwind-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.8.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
