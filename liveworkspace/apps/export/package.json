{
  "name": "@liveworkspace/export-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --inspector-port 9137 --port 3012",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@liveworkspace/app-doors": "workspace:*",
    "@liveworkspace/data-export": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:*",
    "@liveworkspace/render-png": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
