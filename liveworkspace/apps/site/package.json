{
  "name": "@liveworkspace/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/asset-prefix.mjs",
    "deploy": "wrangler deploy",
