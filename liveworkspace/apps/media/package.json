{
  "name": "@liveworkspace/media-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-sqlite-d1.ts"
  },
  "scripts": {
    "dev": "node ../../../packages/api-kit/scripts/dev-vars.ts && CI=1 wrangler d1 migrations apply liveworkspace-media --local && wrangler dev --inspector-port 9133 --port 8792",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-media --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-media --remote"
  },
  "dependencies": {
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:*",
    "@liveworkspace/render-png": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@liveworkspace/api-kit": "workspace:^",
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
