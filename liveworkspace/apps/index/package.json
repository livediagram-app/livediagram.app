{
  "name": "@liveworkspace/index-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-sqlite-d1.ts"
  },
  "scripts": {
    "dev": "node ../../../packages/api-kit/scripts/dev-vars.ts && CI=1 wrangler d1 migrations apply liveworkspace-index --local && wrangler dev --inspector-port 9134 --port 8793",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && vitest-budgets",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-index --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-index --remote"
  },
  "dependencies": {
    "@liveworkspace/api-kit": "workspace:*",
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/app-doors": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:^",
    "@liveworkspace/model-core": "workspace:*",
    "@liveworkspace/migration": "workspace:^",
    "@liveworkspace/sites": "workspace:^",
    "@liveworkspace/telemetry": "workspace:*",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@liveworkspace/vitest-config": "workspace:^",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
