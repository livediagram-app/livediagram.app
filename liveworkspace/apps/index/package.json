{
  "name": "@liveworkspace/index-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-sqlite-d1.ts"
  },
  "scripts": {
    "dev": "CI=1 wrangler d1 migrations apply liveworkspace-index --local && wrangler dev --inspector-port 9134 --port 8793",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-index --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-index --remote"
  },
  "dependencies": {
    "@liveworkspace/api-kit": "workspace:*",
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/migration": "workspace:^",
    "@liveworkspace/sites": "workspace:^",
    "@liveworkspace/telemetry": "workspace:*",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@liveworkspace/vitest-config": "workspace:^",
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
