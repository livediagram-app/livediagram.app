# Copy to .dev.vars for `pnpm dev`. The Turnstile keys are Cloudflare's always-pass test keys.
ENVIRONMENT=development
# The site's dev server, which serves this Worker's /api/auth beside the sign-in pages, as
# liveworkspace.app does in production.
BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ADMIN_TOKEN=local-admin-token
EMAIL_FROM=sign-in@liveworkspace.app
# Emails go through the EMAIL binding (wrangler.toml), which `wrangler dev` simulates: each email (and its
# sign-in code) is printed to the dev server's log rather than sent.
# Optional: an OAuth client from Google Cloud with http://localhost:3000/api/auth/callback/google as
# an authorised redirect URI. Without both, the pages offer email codes only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signing in on each app's own address (http://localhost:3100/sign-in, …), as in production. Google stays on
# localhost:3000 until http://localhost:3100/api/workspace/auth/callback/google (and 3200, 3300, 3400) are authorised
# redirect URIs of the Google client and this is "true".
SIGN_IN_ON_APP_ORIGINS=true
GOOGLE_ON_APP_ORIGINS=false
# The index service (liveworkspace/apps/index), told when a guest signs in. Optional: without both,
# signing in leaves the guest's things where they are.
INDEX_URL=http://localhost:8793/api/index
INDEX_MERGE_KEY=dev-index-merge-key
# The telemetry service (liveworkspace/apps/telemetry), told when an onboarding email goes. Optional:
# the keys are the telemetry Worker's dev keys; an app without one isn't counted.
TELEMETRY_URL=http://localhost:8790/api/telemetry
TELEMETRY_KEY_LIVEDIAGRAM=dev-livediagram-key
TELEMETRY_KEY_LIVEPLANNER=dev-liveplanner-key
TELEMETRY_KEY_LIVEDOCUMENTS=dev-livedocuments-key
TELEMETRY_KEY_LIVEDESIGN=dev-livedesign-key
# The migration's returning guests (src/legacy-guests.ts): the old livediagram.app's GUEST_ID_HMAC_SECRET. Optional:
# without it, POST /api/account/internal/legacy-guests/claim is a plain 404.
LEGACY_GUEST_ID_HMAC_SECRET=
