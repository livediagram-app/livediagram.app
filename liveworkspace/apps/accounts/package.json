{
  "name": "@liveworkspace/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream localhost:3300",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-accounts --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-accounts --remote",
    "clerk:import": "node scripts/import-clerk-users.ts",
    "e2e:local": "tsx scripts/e2e-local.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "better-auth": "1.7.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@liveworkspace/auth-client": "workspace:*",
    "@types/node": "^26.6.4",
    "oxlint": "^1.88.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
