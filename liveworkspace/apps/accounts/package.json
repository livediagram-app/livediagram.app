{
  "name": "@liveworkspace/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../../packages/api-kit/scripts/dev-vars.ts && CI=1 wrangler d1 migrations apply liveworkspace-accounts --local && node scripts/seed-local-clients.ts && wrangler dev --inspector-port 9130 --port 8787 --local-upstream localhost:3000",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-accounts --local",
    "db:seed:local": "node scripts/seed-local-clients.ts",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-accounts --remote",
    "clerk:import": "node scripts/import-clerk-users.ts",
    "e2e:local": "tsx scripts/e2e-local.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.14",
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/brand": "workspace:^",
    "@liveworkspace/data-export": "workspace:^",
    "@liveworkspace/email": "workspace:*",
    "@liveworkspace/index-client": "workspace:^",
    "@liveworkspace/migration": "workspace:^",
    "@liveworkspace/settings": "workspace:*",
    "@liveworkspace/sites": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*",
    "better-auth": "1.7.14",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@liveworkspace/api-kit": "workspace:^",
    "@liveworkspace/vitest-config": "workspace:^",
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
