{
  "name": "@liveworkspace/community-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-sqlite-d1.ts"
  },
  "scripts": {
    "dev": "wrangler dev --inspector-port 9132 --port 8791",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-community --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-community --remote"
  },
  "dependencies": {
    "@liveworkspace/community": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
