{
  "name": "@liveworkspace/telemetry-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../../packages/api-kit/scripts/dev-vars.ts && CI=1 wrangler d1 migrations apply liveworkspace-telemetry --local && wrangler dev --inspector-port 9131 --port 8790",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-telemetry --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-telemetry --remote"
  },
  "dependencies": {
    "@livedesign/api-schema": "workspace:*",
    "@livediagram/api-schema": "workspace:*",
    "@livedocuments/api-schema": "workspace:*",
    "@livehuddle/api-schema": "workspace:*",
    "@liveplanner/api-schema": "workspace:*",
    "@liveworkspace/api-kit": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/settings": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
