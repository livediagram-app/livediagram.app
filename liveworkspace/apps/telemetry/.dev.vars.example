# Local development: `wrangler dev` reads .dev.vars. Development takes events from localhost pages.
ENVIRONMENT=development
TELEMETRY_KEY_LIVEDIAGRAM=dev-livediagram-key
TELEMETRY_KEY_LIVEPLANNER=dev-liveplanner-key
TELEMETRY_KEY_LIVEDOCUMENTS=dev-livedocuments-key
TELEMETRY_KEY_LIVEDESIGN=dev-livedesign-key
