{
  "name": "@liveworkspace/subscription-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node ../../../packages/api-kit/scripts/dev-vars.ts && CI=1 wrangler d1 migrations apply liveworkspace-subscription --local && wrangler dev --inspector-port 9138 --port 8794",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stripe:setup": "node scripts/stripe-setup.ts",
    "db:migrate:local": "wrangler d1 migrations apply liveworkspace-subscription --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveworkspace-subscription --remote"
  },
  "dependencies": {
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/index-app": "workspace:^",
    "@liveworkspace/sites": "workspace:^",
    "@liveworkspace/subscription": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@liveworkspace/api-kit": "workspace:^",
    "@liveworkspace/vitest-config": "workspace:^",
    "@types/node": "^26.6.6",
    "jose": "^6.2.17",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
