{
  "name": "@liveworkspace/help",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-scopes.mjs --write-scope",
    "dev": "node ../../../packages/next-config/scripts/next-dev.mjs --port 3020",
    "build": "node scripts/build-scopes.mjs",
    "build:one": "next build",
    "build:scope": "node scripts/build-scopes.mjs --write-scope && next build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .next .next-dev .next-analyze out dist node_modules .turbo"
  },
  "dependencies": {
    "@livedesign/telemetry-client": "workspace:*",
    "@livedesign/templates": "workspace:*",
    "@livedesign/ui": "workspace:*",
    "@livediagram/telemetry-client": "workspace:*",
    "@livediagram/templates": "workspace:*",
    "@livediagram/ui": "workspace:*",
    "@livedocuments/document": "workspace:*",
    "@livedocuments/telemetry-client": "workspace:*",
    "@livedocuments/templates": "workspace:*",
    "@livedocuments/ui": "workspace:*",
    "@livehuddle/telemetry-client": "workspace:*",
    "@livehuddle/templates": "workspace:*",
    "@livehuddle/ui": "workspace:*",
    "@liveknowledge/telemetry-client": "workspace:*",
    "@liveknowledge/ui": "workspace:*",
    "@liveplanner/sheets": "workspace:*",
    "@liveplanner/telemetry-client": "workspace:*",
    "@liveplanner/ui": "workspace:*",
    "@liveworkspace/brand": "workspace:*",
    "@liveworkspace/help-registry": "workspace:*",
    "@liveworkspace/help-site": "workspace:*",
    "@liveworkspace/icons": "workspace:^",
    "@liveworkspace/sites": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*",
    "@liveworkspace/telemetry-client": "workspace:*",
    "@liveworkspace/trusted-types": "workspace:*",
    "@liveworkspace/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.4.6",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@livedesign/help-registry": "workspace:*",
    "@livedesign/tailwind-config": "workspace:*",
    "@livediagram/help-registry": "workspace:*",
    "@livedocuments/help-registry": "workspace:*",
    "@livedocuments/tailwind-config": "workspace:*",
    "@livehuddle/help-registry": "workspace:*",
    "@livehuddle/tailwind-config": "workspace:*",
    "@liveknowledge/help-registry": "workspace:*",
    "@liveknowledge/tailwind-config": "workspace:*",
    "@liveplanner/help-registry": "workspace:*",
    "@liveplanner/tailwind-config": "workspace:*",
    "@liveworkspace/next-config": "workspace:*",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/style-guards": "workspace:*",
    "@liveworkspace/tailwind-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.94.0",
