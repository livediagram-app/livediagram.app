# The one help centre's environment variables (liveworkspace/docs/specs/017-help/help-centre.md).
#
# This app is a static export, built once per scope. Anything prefixed NEXT_PUBLIC_ is baked into the build and
# shipped to the browser; the repo is public, so never put secrets here.

# Which scope `pnpm dev` serves (the predev step writes lib/scope.generated.ts and app/scope.generated.css for it):
# livediagram (the default), liveplanner, livedocuments, livedesign, livehuddle, liveknowledge or all.
HELP_SCOPE=

# Anonymous, first-party usage telemetry switch, as each product's help had it: the literal string "true" sends
# events, anything else (including unset) sends nothing.
NEXT_PUBLIC_TELEMETRY_ENABLED=

# The liveworkspace telemetry service. Unset means production's, https://www.liveworkspace.app/api/telemetry.
#     NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8790/api/telemetry
NEXT_PUBLIC_TELEMETRY_URL=
