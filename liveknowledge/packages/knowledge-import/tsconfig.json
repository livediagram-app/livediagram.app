{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for the Confluence reader, which walks the inert document `parseInert` answers. `node` for the tests
    // alone (the CPU-time budget reads the process's CPU clock); the source never touches the filesystem.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  // The Trusted Types globals parseInert is typed with, which the trusted-types package declares for its own build.
  "include": ["src/**/*.ts", "../../../packages/trusted-types/src/globals.d.ts"],
  "exclude": ["node_modules"]
}
