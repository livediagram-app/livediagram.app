{
  "name": "@livepages/licences",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/contract.ts",
  "types": "./src/contract.ts",
  "exports": {
    ".": "./src/contract.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "verify": "node scripts/verify.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "devDependencies": {
    "@livepages/oxlint-config": "workspace:*",
    "@livepages/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
