{
  "name": "@livedocuments/diagram-lint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && vitest-budgets",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "dependencies": {
    "@livedocuments/api-schema": "workspace:*",
    "@livedocuments/document": "workspace:*",
    "@liveworkspace/diagram-lint": "workspace:*"
  },
  "devDependencies": {
    "@livedocuments/edit-operations": "workspace:*",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@livedocuments/templates": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
