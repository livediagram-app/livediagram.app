# API worker environment variables (docs/specs/002-project-scope/secrets-policy.md).
#
# This worker runs on Cloudflare Workers, not Node. Local dev reads
# these from `apps/api/.dev.vars` (gitignored, see wrangler docs);
# production reads them from `wrangler.toml` [vars] for plain
# strings, and from `wrangler secret put` for secrets. This file is
# a copy-paste reference for what the worker consults at runtime,
# committed to the repo so contributors have one place to look.
#
# Per docs/specs/002-project-scope/secrets-policy.md the repo is public, so never put real secret values
# in this file: hex / token shapes are placeholders only.

# Sign-in through the liveworkspace accounts Worker
# (docs/specs/014-identity/auth-and-guest-access.md): every caller, a guest
# included, holds a token it minted. Unset ACCOUNTS_URL or API_RESOURCE =
# nobody is signed in or a guest. Drop into .dev.vars for local dev; provision each via
# `wrangler secret put <NAME>` in production (wrangler.toml lists them).
#
# The worker checks each access token locally against the accounts Worker's
# published keys (${ACCOUNTS_URL}/api/auth/jwks), its issuer
# (${ACCOUNTS_URL}/api/auth) and this API's own audience (API_RESOURCE), so a
# token minted for another liveworkspace app is refused. Teams
# (docs/specs/013-workspace/teams.md) reads the token's verified `email` claim
# to auto-connect pending invites.
# ACCOUNTS_URL=https://accounts.example
# API_RESOURCE=https://livedocuments.example/api
# ACCOUNTS_CLIENT_ID=replace-with-client-id
# ACCOUNTS_CLIENT_SECRET=replace-with-client-secret
#
# Local dev only: the origin the browser comes back to after signing in,
# when the api runs behind the router (pnpm dev). The accounts Worker must
# list ${AUTH_ORIGIN}/api/auth/callback as a redirect URI.
# AUTH_ORIGIN=http://localhost:3300

# The central index (liveworkspace/docs/specs/004-index/one-explorer.md): where every document is filed and who may open it. The
# grants this api checks are signed by ${INDEX_ORIGIN}/api/index/jwks; INDEX_KEY is livedocuments's key there
# (a secret, the same value as the index's key for livedocuments), which the document rooms push their summaries
# with. A plain [vars] string in production (wrangler.toml); locally, liveworkspace's index on 8793.
# INDEX_ORIGIN=http://127.0.0.1:8793
# INDEX_KEY=dev-livedocuments-index-key

# This worker's own telemetry (docs/specs/017-telemetry/telemetry.md), sent to liveworkspace's central
# service (liveworkspace/docs/specs/008-telemetry/telemetry.md). Only the literal string "true"
# enables it; unset / "false" / anything else sends nothing, so a
# deployment stays silent by default.
# TELEMETRY_ENABLED=true

# The central service. Unset is production's, https://www.liveworkspace.app/api/telemetry;
# locally, a `wrangler dev` of liveworkspace/apps/telemetry.
# TELEMETRY_URL=http://localhost:8790/api/telemetry

# livedocuments' Worker key for that service (a secret), sent as X-Telemetry-Key: a
# Worker sends no Origin, so this is what lets its posts speak for livedocuments.app.
# The SAME value on the mcp worker, and as the service's TELEMETRY_KEY_LIVEDOCUMENTS
# (`dev-livedocuments-key` in its .dev.vars.example). Unset = nothing is sent.
# TELEMETRY_KEY=dev-livedocuments-key

# Images live in liveworkspace's media service (liveworkspace/docs/specs/006-media/media.md), which keeps every app's uploads and
# their caps. livedocuments' secret on it, the same value as the service's MEDIA_KEY_LIVEDOCUMENTS (its local
# .dev.vars.example uses dev-livedocuments-media-key). Unset = no images: the image endpoints answer 503.
# MEDIA_KEY=dev-livedocuments-media-key
# Where the service is. Unset means production's, https://www.liveworkspace.app/api/media.
# MEDIA_URL=http://localhost:8792/api/media

# liveworkspace's Drive mirror (liveworkspace/docs/specs/005-drive/drive.md "Contracts > The apps"): livedocuments' secret on it, the
# same value as the service's DRIVE_KEY_LIVEDOCUMENTS. It opens the internal export door (`format=file`) and the
# import door, nothing else. Unset = the mirror cannot export or import documents.
# DRIVE_KEY=dev-livedocuments-drive-key

# Optional transactional email via Cloudflare Email Service (docs/specs/014-identity/transactional-email.md,
# liveworkspace/docs/specs/003-accounts/email.md). It needs no key: the `send_email` binding EMAIL in wrangler.toml is the
# credential, and `wrangler dev` simulates it, printing each email instead of sending it. No binding means no
# email is ever sent; addresses come from the liveworkspace accounts Worker. EMAIL_FROM + APP_BASE_URL
# are optional [vars] (defaults: "livedocuments <hello@livedocuments.app>"
# and "https://www.livedocuments.app"). The From domain must be onboarded to Email Service.
# EMAIL_FROM=livedocuments <hello@livedocuments.app>
# APP_BASE_URL=https://www.livedocuments.app

# The live build id (docs/specs/016-platform/stale-builds.md): the deploy's commit, the same value
# as the editor build's NEXT_PUBLIC_BUILD_ID. The deploy workflow sets both; unset leaves it off
# the server release signal (an open editor then never treats itself as stale).
# BUILD_ID=

# The migration from the old livediagram.app (docs/migration.md "The apps' migration door"): the migrate tool's key on
# PUT /api/internal/items/:id/migration, which it opens and nothing else. Set only while the migration runs, then
# removed. Unset = the door takes the index's INDEX_KEY alone.
# MIGRATION_KEY=dev-livedocuments-migration-key
