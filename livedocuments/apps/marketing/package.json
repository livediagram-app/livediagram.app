{
  "name": "@livedocuments/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3301",
    "build": "node ../../../packages/licences/scripts/generate-product.ts --product ../../packages/licences --out . && next build && node ../../../packages/licences/scripts/verify.ts .",
    "licences": "node ../../../packages/licences/scripts/generate-product.ts --product ../../packages/licences --out .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-analyze out generated public/licences node_modules .turbo"
  },
  "dependencies": {
    "@livedocuments/api-schema": "workspace:*",
    "@livedocuments/template-previews": "workspace:*",
    "@livedocuments/templates": "workspace:*",
    "@livedocuments/ui": "workspace:*",
    "@liveworkspace/comparisons": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/licences": "workspace:*",
    "@liveworkspace/marketing-site": "workspace:*",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@livedocuments/document": "workspace:*",
    "@livedocuments/help-registry": "workspace:*",
    "@livedocuments/licences": "workspace:*",
    "@livedocuments/tailwind-config": "workspace:*",
    "@liveworkspace/next-config": "workspace:*",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/style-guards": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
