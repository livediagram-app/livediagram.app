{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Off: turbo otherwise appends a managed block to AGENTS.md whenever it detects an AI agent,
  // leaving every agent's work tree dirty. AGENTS.md changes only by hand.
  "agentGuidance": false,
  // Every workspace's tsconfig.json extends one of these files, but it sits outside all
  // of them, so it is invisible to the per-package input hash. Without it here,
  // tightening a compiler flag in the base config replays a cache hit and
  // `pnpm typecheck` reports success on code it never checked.
  "globalDependencies": [
    "tsconfig.base.json",
    "livediagram/tsconfig.base.json",
    "liveplanner/tsconfig.base.json",
    "livedesign/tsconfig.base.json",
    "livedocuments/tsconfig.base.json",
    "livehuddle/tsconfig.base.json",
    "liveknowledge/tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    // liveworkspace.app's build also generates its /licences page from what the site
    // and the platform's Workers bundle (liveworkspace/docs/specs/010-site/site.md "Licences"), so
    // their sources, the packages the site draws from and the lockfile are inputs.
    // It analyses the one help centre's bundle too (its "Help centre" row), so it runs after the help's own build:
    // Next's analyzer shares an app's .next/cache whatever its distDir, and two processes on it corrupt it.
    "@liveworkspace/site#build": {
      "dependsOn": ["^build", "@liveworkspace/help#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/liveworkspace/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/livediagram/packages/**",
        "$TURBO_ROOT$/liveplanner/packages/**",
        "$TURBO_ROOT$/livedocuments/packages/**",
        "$TURBO_ROOT$/livedesign/packages/**",
        "$TURBO_ROOT$/liveknowledge/packages/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/liveworkspace/apps/site/generated/**",
        "!$TURBO_ROOT$/liveworkspace/apps/site/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    // Marketing's build also generates the /licences page from what EVERY app
    // bundles (docs/specs/002-project-scope/third-party-licences.md), so any
    // app's or package's source, or the lockfile, is an input: a change there
    // must never replay a cached page that lists stale works. It runs after the
    // other apps' builds because Next's analyzer uses an app's Turbopack build
    // cache (.next/cache) whatever its distDir: beside that app's own build, the
    // two processes corrupt it.
    "@livediagram/marketing#build": {
      "dependsOn": [
        "^build",
        "@livediagram/editor#build",
        "@livediagram/api#build",
        "@livediagram/mcp#build",
        "@livediagram/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livediagram/apps/**",
        "$TURBO_ROOT$/livediagram/packages/**",
        // The shared @liveworkspace/* packages ship in these bundles too.
        "$TURBO_ROOT$/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livediagram/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livediagram/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // The telemetry dashboard's emitter checks (app/telemetry) scan every product's apps and packages and the
    // shared code that sends in their names, so those sources are inputs: a new or moved emitter must never
    // replay a cached pass.
    "@liveworkspace/site#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livediagram/apps/**",
        "$TURBO_ROOT$/livediagram/packages/**",
        "$TURBO_ROOT$/liveplanner/apps/**",
        "$TURBO_ROOT$/liveplanner/packages/**",
        "$TURBO_ROOT$/livedocuments/apps/**",
        "$TURBO_ROOT$/livedocuments/packages/**",
        "$TURBO_ROOT$/livedesign/apps/**",
        "$TURBO_ROOT$/livedesign/packages/**",
        "$TURBO_ROOT$/liveknowledge/apps/**",
        "$TURBO_ROOT$/liveknowledge/packages/**",
        "$TURBO_ROOT$/liveworkspace/apps/accounts/src/**",
        "$TURBO_ROOT$/packages/help-site/src/**",
        "$TURBO_ROOT$/packages/telemetry-client/src/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**"
      ]
    },
    // The shared marketing guards read every product's marketing app (src/guards/targets.ts), so their
    // sources are inputs too: a change in one app must never replay a cached pass.
    "@liveworkspace/marketing-site#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livediagram/apps/marketing/**",
        "$TURBO_ROOT$/liveplanner/apps/marketing/**",
        "$TURBO_ROOT$/livedocuments/apps/marketing/**",
        "$TURBO_ROOT$/livedesign/apps/marketing/**",
        "$TURBO_ROOT$/liveknowledge/apps/marketing/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/generated/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**"
      ]
    },
    // The one help centre's guards (repo paths and spec links quoted in docs and code, each app's UI labels and
    // shortcuts against its editor) read every product's tracked files, so every tracked file is an input: a
    // docs-only change must never replay a cached pass (docs/specs/003-system-architecture/testing.md "Before a push").
    "@liveworkspace/help#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "@liveworkspace/help#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "staging:check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    // liveplanner: the same per-package rules as livediagram above, on its own paths.
    "@liveplanner/marketing#build": {
      "dependsOn": [
        "^build",
        "@liveplanner/editor#build",
        "@liveplanner/api#build",
        "@liveplanner/mcp#build",
        "@liveplanner/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/liveplanner/apps/**",
        "$TURBO_ROOT$/liveplanner/packages/**",
        // The shared @liveworkspace/* packages ship in these bundles too.
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/liveplanner/apps/marketing/generated/**",
        "!$TURBO_ROOT$/liveplanner/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    // livedesign: the same per-package rules as livediagram above, on its own paths.
    "@livedesign/marketing#build": {
      "dependsOn": [
        "^build",
        "@livedesign/live#build",
        "@livedesign/api#build",
        "@livedesign/mcp#build",
        "@livedesign/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livedesign/apps/**",
        "$TURBO_ROOT$/livedesign/packages/**",
        // The shared @liveworkspace/* packages ship in these bundles too.
        "$TURBO_ROOT$/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livedesign/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livedesign/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    // The naming guard (src/design-naming.test.ts) reads every tracked file under livedesign/, the apps
    // that depend on this package included, so they are inputs: a word in apps/live must run it.
    "@livedesign/design#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livedesign/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**"
      ]
    },
    "@livedesign/design#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livedesign/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**"
      ]
    },
    // livedocuments: the same per-package rules as livediagram above, on its own paths.
    "@livedocuments/marketing#build": {
      "dependsOn": [
        "^build",
        "@livedocuments/editor#build",
        "@livedocuments/api#build",
        "@livedocuments/mcp#build",
        "@livedocuments/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livedocuments/apps/**",
        "$TURBO_ROOT$/livedocuments/packages/**",
        // The shared @liveworkspace/* packages ship in these bundles too.
        "$TURBO_ROOT$/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livedocuments/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livedocuments/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    // liveknowledge: the same per-package rules as livediagram above, on its own paths.
    "@liveknowledge/marketing#build": {
      "dependsOn": [
        "^build",
        "@liveknowledge/editor#build",
        "@liveknowledge/api#build",
        "@liveknowledge/mcp#build",
        "@liveknowledge/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/liveknowledge/apps/**",
        "$TURBO_ROOT$/liveknowledge/packages/**",
        // The shared @liveworkspace/* packages ship in these bundles too.
        "$TURBO_ROOT$/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/liveknowledge/apps/marketing/generated/**",
        "!$TURBO_ROOT$/liveknowledge/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    // livehuddle: the same per-package rules as livediagram above, on its own paths.
    "@livehuddle/marketing#build": {
      "dependsOn": [
        "^build",
        "@livehuddle/editor#build",
        "@livehuddle/api#build",
        "@livehuddle/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livehuddle/apps/**",
        "$TURBO_ROOT$/livehuddle/packages/**",
        // The shared @liveworkspace/* packages ship in these bundles too.
        "$TURBO_ROOT$/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livehuddle/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livehuddle/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    }
  }
}
