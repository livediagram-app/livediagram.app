{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Off: turbo otherwise appends a managed block to AGENTS.md whenever it detects an AI agent,
  // leaving every agent's work tree dirty. AGENTS.md changes only by hand.
  "agentGuidance": false,
  // Every workspace's tsconfig.json extends one of these files, but it sits outside all
  // of them, so it is invisible to the per-package input hash. Without it here,
  // tightening a compiler flag in the base config replays a cache hit and
  // `pnpm typecheck` reports success on code it never checked.
  "globalDependencies": [
    "tsconfig.base.json",
    "livediagram/tsconfig.base.json",
    "liveplanner/tsconfig.base.json",
    "livedesign/tsconfig.base.json",
    "livedocuments/tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    // Marketing's build also generates the /licences page from what EVERY app
    // bundles (docs/specs/002-project-scope/third-party-licences.md), so any
    // app's or package's source, or the lockfile, is an input: a change there
    // must never replay a cached page that lists stale works. It runs after the
    // other apps' builds because Next's analyzer uses an app's Turbopack build
    // cache (.next/cache) whatever its distDir: beside that app's own build, the
    // two processes corrupt it.
    "@livediagram/marketing#build": {
      "dependsOn": [
        "^build",
        "@livediagram/editor#build",
        "@livediagram/help#build",
        "@livediagram/community#build",
        "@livediagram/api#build",
        "@livediagram/mcp#build",
        "@livediagram/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livediagram/apps/**",
        "$TURBO_ROOT$/livediagram/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livediagram/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livediagram/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // The help app's guards (repo paths and spec links quoted in docs and code) read every tracked
    // file, so every tracked file is an input: a docs-only change must never replay a cached pass
    // (docs/specs/003-system-architecture/testing.md "Before a push").
    "@livediagram/help#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livediagram/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "@livediagram/help#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livediagram/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "staging:check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    // liveplanner: the same per-package rules as livediagram above, on its own paths.
    "@liveplanner/marketing#build": {
      "dependsOn": [
        "^build",
        "@liveplanner/editor#build",
        "@liveplanner/help#build",
        "@liveplanner/api#build",
        "@liveplanner/mcp#build",
        "@liveplanner/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/liveplanner/apps/**",
        "$TURBO_ROOT$/liveplanner/packages/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/liveplanner/apps/marketing/generated/**",
        "!$TURBO_ROOT$/liveplanner/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    "@liveplanner/help#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/liveplanner/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "@liveplanner/help#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/liveplanner/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    // livedesign: the same per-package rules as livediagram above, on its own paths.
    "@livedesign/marketing#build": {
      "dependsOn": [
        "^build",
        "@livedesign/live#build",
        "@livedesign/help#build",
        "@livedesign/telemetry#build",
        "@livedesign/api#build",
        "@livedesign/mcp#build",
        "@livedesign/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livedesign/apps/**",
        "$TURBO_ROOT$/livedesign/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livedesign/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livedesign/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    "@livedesign/help#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livedesign/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "@livedesign/help#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livedesign/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    // livedocuments: the same per-package rules as livediagram above, on its own paths.
    "@livedocuments/marketing#build": {
      "dependsOn": [
        "^build",
        "@livedocuments/live#build",
        "@livedocuments/help#build",
        "@livedocuments/telemetry#build",
        "@livedocuments/api#build",
        "@livedocuments/mcp#build",
        "@livedocuments/router#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/livedocuments/apps/**",
        "$TURBO_ROOT$/livedocuments/packages/**",
        // Explicit root globs ignore .gitignore: keep build output out.
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/next-env.d.ts",
        "!$TURBO_ROOT$/livedocuments/apps/marketing/generated/**",
        "!$TURBO_ROOT$/livedocuments/apps/marketing/public/licences/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "generated/**", "public/licences/**"]
    },
    "@livedocuments/help#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livedocuments/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    },
    "@livedocuments/help#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/livedocuments/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next*/**",
        "!$TURBO_ROOT$/**/out/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/test-results*/**",
        "!$TURBO_ROOT$/**/playwright-report*/**",
        "!$TURBO_ROOT$/.git/**"
      ]
    }
  }
}
