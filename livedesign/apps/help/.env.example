# Help centre environment variables.
#
# This app is a static export (docs/specs/018-help/help-app.md). Anything prefixed
# NEXT_PUBLIC_ is baked into the build and shipped to the browser;
# per docs/specs/002-project-scope/secrets-policy.md the repo is public, so never put secrets here.

# Anonymous, first-party usage telemetry switch (docs/specs/017-telemetry/telemetry.md), mirroring the
# live app. When set to the literal string "true" the help
# centre's `track()` buffers events and POSTs them to liveworkspace's central telemetry service;
# anything else (including unset) makes it a no-op so nothing leaves the
# browser. The default (unset) is OFF. Pair with `TELEMETRY_ENABLED=true`
# on the central telemetry service (which decides what is stored) to turn
# the system on end-to-end.
NEXT_PUBLIC_TELEMETRY_ENABLED=

# Where the events go: liveworkspace's central telemetry service
# (liveworkspace/docs/specs/008-telemetry/telemetry.md). Unset is production's,
# https://www.liveworkspace.app/api/telemetry. For local development point it at a
# `wrangler dev` of liveworkspace/apps/telemetry:
#     NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8790/api/telemetry
NEXT_PUBLIC_TELEMETRY_URL=
