{
  "name": "@livedesign/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 3301",
    "build": "node ../../packages/licences/scripts/generate.ts --out . && next build && node ../../packages/licences/scripts/verify.ts .",
    "licences": "node ../../packages/licences/scripts/generate.ts --out .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-analyze out generated public/licences node_modules .turbo"
  },
  "dependencies": {
    "@livedesign/api-schema": "workspace:*",
    "@livedesign/icons": "workspace:*",
    "@livedesign/template-previews": "workspace:*",
    "@livedesign/templates": "workspace:*",
    "@livedesign/ui": "workspace:*",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@livedesign/document": "workspace:*",
    "@livedesign/help-registry": "workspace:*",
    "@livedesign/licences": "workspace:*",
    "@livedesign/next-config": "workspace:*",
    "@livedesign/oxlint-config": "workspace:*",
    "@livedesign/tailwind-config": "workspace:*",
    "@livedesign/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
