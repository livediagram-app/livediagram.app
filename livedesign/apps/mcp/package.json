{
  "name": "@livepages/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --inspector-port 9430",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage"
  },
  "dependencies": {
    "@livepages/agent-verbs": "workspace:*",
    "@livepages/api-client": "workspace:*",
    "@livepages/api-schema": "workspace:*",
    "@livepages/diagram-lint": "workspace:*",
    "@livepages/document": "workspace:*",
    "@livepages/edit-operations": "workspace:*",
    "@livepages/forms": "workspace:*",
    "@livepages/icons": "workspace:*",
    "@livepages/items": "workspace:*",
    "@livepages/plan-art": "workspace:*",
    "@livepages/render-png": "workspace:*",
    "@livepages/sheets": "workspace:*",
    "@livepages/templates": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@livepages/oxlint-config": "workspace:*",
    "@livepages/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
