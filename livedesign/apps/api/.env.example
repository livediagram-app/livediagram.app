# API worker environment variables (docs/specs/002-project-scope/secrets-policy.md).
#
# This worker runs on Cloudflare Workers, not Node. Local dev reads
# these from `apps/api/.dev.vars` (gitignored, see wrangler docs);
# production reads them from `wrangler.toml` [vars] for plain
# strings, and from `wrangler secret put` for secrets. This file is
# a copy-paste reference for what the worker consults at runtime,
# committed to the repo so contributors have one place to look.
#
# Per docs/specs/002-project-scope/secrets-policy.md the repo is public, so never put real secret values
# in this file: hex / token shapes are placeholders only.

# Sign-in through the liveworkspace accounts Worker
# (docs/specs/014-identity/auth-and-guest-access.md): every caller, a guest
# included, holds a token it minted. Unset ACCOUNTS_URL or API_RESOURCE =
# nobody is signed in or a guest. Drop into .dev.vars for local dev; provision each via
# `wrangler secret put <NAME>` in production (wrangler.toml lists them).
#
# The worker checks each access token locally against the accounts Worker's
# published keys (${ACCOUNTS_URL}/api/auth/jwks), its issuer
# (${ACCOUNTS_URL}/api/auth) and this API's own audience (API_RESOURCE), so a
# token minted for another liveworkspace app is refused. Teams
# (docs/specs/013-workspace/teams.md) reads the token's verified `email` claim
# to auto-connect pending invites.
# ACCOUNTS_URL=https://accounts.example
# API_RESOURCE=https://livedesign.example/api
# ACCOUNTS_CLIENT_ID=replace-with-client-id
# ACCOUNTS_CLIENT_SECRET=replace-with-client-secret
#
# Local dev only: the origin the browser comes back to after signing in,
# when the api runs behind the router (pnpm dev). The accounts Worker must
# list ${AUTH_ORIGIN}/api/auth/callback as a redirect URI.
# AUTH_ORIGIN=http://localhost:3400

# The central index (liveworkspace/docs/one-explorer.md): where every design is filed and who may open it. The
# grants this api checks are signed by ${INDEX_ORIGIN}/api/index/jwks; INDEX_KEY is livedesign's key there
# (a secret, the same value as the index's key for livedesign), which the design rooms push their summaries
# with. A plain [vars] string in production (wrangler.toml); locally, liveworkspace's index on 8793.
# INDEX_ORIGIN=http://127.0.0.1:8793
# INDEX_KEY=dev-livedesign-index-key

# This worker's own telemetry (docs/specs/017-telemetry/telemetry.md), sent to liveworkspace's central
# service (liveworkspace/docs/telemetry.md). Only the literal string "true"
# enables it; unset / "false" / anything else sends nothing, so OSS
# self-host stays silent by default.
# TELEMETRY_ENABLED=true

# The central service. Unset is production's, https://liveworkspace.app/api/telemetry;
# locally, a `wrangler dev` of liveworkspace/apps/telemetry.
# TELEMETRY_URL=http://localhost:8790/api/telemetry

# livedesign's Worker key for that service (a secret), sent as X-Telemetry-Key: a
# Worker sends no Origin, so this is what lets its posts speak for livedesign.app.
# The SAME value on the mcp worker, and as the service's TELEMETRY_KEY_LIVEDESIGN
# (`dev-livedesign-key` in its .dev.vars.example). Unset = nothing is sent.
# TELEMETRY_KEY=dev-livedesign-key

# Images live in liveworkspace's media service (liveworkspace/docs/media.md), which keeps every app's uploads and
# their caps. livedesign's secret on it, the same value as the service's MEDIA_KEY_LIVEDESIGN (its local
# .dev.vars.example uses dev-livedesign-media-key). Unset = no images: the image endpoints answer 503.
# MEDIA_KEY=dev-livedesign-media-key
# Where the service is. Unset means production's, https://liveworkspace.app/api/media.
# MEDIA_URL=http://localhost:8792/api/media

# Optional cap on the photo blob store per tab (docs/specs/031-photo/photo-store.md "Limits"): the
# most bytes of photo page tiles, sources and previews one tab may hold. Decimal string; unset / 0 /
# non-numeric = no limit. Hosted livedesign.app sets 536870912 (512 MB). An upload past it answers
# 403 { error: "photo_full", limit, current }.
# PHOTO_MAX_BYTES_PER_TAB=536870912

# Optional transactional + lifecycle email via Resend (docs/specs/014-identity/transactional-email.md). An
# absent RESEND_API_KEY means no email is ever sent. RESEND_FROM + APP_BASE_URL
# are optional [vars] (defaults: "livedesign <hello@livedesign.app>"
# and "https://livedesign.app"). The From domain must be verified in
# Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM=livedesign <hello@livedesign.app>
# APP_BASE_URL=https://livedesign.app

# The live build id (docs/specs/016-platform/stale-builds.md): the deploy's commit, the same value
# as the editor build's NEXT_PUBLIC_BUILD_ID. The deploy workflow sets both; unset leaves it off
# the server release signal (an open editor then never treats itself as stale).
# BUILD_ID=
