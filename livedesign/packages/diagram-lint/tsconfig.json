{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // Explicit, because TypeScript includes no @types package by default: the routing fixtures test reads its JSON
    // fixtures with `node:fs`. The source never touches the filesystem; only that test does.
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
