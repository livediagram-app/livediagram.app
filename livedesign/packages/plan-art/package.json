{
  "name": "@livepages/plan-art",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-fixtures": "./src/test-fixtures.ts"
  },
  "scripts": {
