    "@livepages/ui": "workspace:*"
  },
  "devDependencies": {
    "@livepages/oxlint-config": "workspace:*",
    "@livepages/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
