# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
# Anchored to the repo root on purpose. An unanchored `build/` matches a
# directory of that name at ANY depth, and it silently untracked the palette's
# Build help article (spec/132) at apps/help/app/palette/build/page.mdx: the
# site still built locally because the file was on disk, and the
# registry-to-disk test passed for the same reason, so only a fresh clone would
# have shown the article missing. Nothing needs the unanchored form — every
# real build output here sits inside .next/, .next-dev/ or out/, each ignored
# in its own right — and anchoring it means no future route or fixture named
# `build` has to be rescued with an exception.
/build/
.next/
.next-dev/
out/
*.tsbuildinfo

# `next-env.d.ts` is generated, and since Next 16 it names the active
# distDir inside itself, so `next dev` (NEXT_DISTDIR=.next-dev) and
# `next build` (.next) rewrite it over each other and leave the tree dirty
# after whichever ran last. Nothing depends on it being tracked: each app's
# tsconfig already picks up the Next types through its own `include`, and
# typecheck is green from a clean checkout without the file. This is also
# what create-next-app's default ignore file does.
next-env.d.ts

# `next dev` (Next 16) drops an `AGENTS.md` + a `CLAUDE.md` pointing at it
# into whichever app it's run from, and re-creates them if deleted. The
# guidance in them is fine to read locally, but this repo keeps its agent
# instructions in one curated root `CLAUDE.md`, and tracking four generated
# copies (one per Next app) would scatter that and hand the background
# auto-committer more churn. Ignored, so they exist locally and never show
# up in `git status`.
apps/*/AGENTS.md
apps/*/CLAUDE.md

# Playwright e2e artifacts (spec/72)
apps/live/test-results/
apps/live/playwright-report/
apps/live/.playwright/

# Turbo
.turbo/

# Wrangler local state (Miniflare D1 / Durable Object simulation cache)
.wrangler/

# Env files
.env
.env.local
.env.*.local
# Wrangler local-dev secrets (mirrors the production secret store but
# stays on disk for `wrangler dev`). Per spec/06 these must never be
# committed.
.dev.vars

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Test
coverage/
.nyc_output/

# Claude Code harness state (scheduled-task locks, worktrees,
# session metadata). Per-user, per-checkout — never source.
.claude/
