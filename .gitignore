# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
# ...except a help ARTICLE whose route is named `build`. The palette's Build
# category (spec/132) lives at /help/palette/build/, and the blanket rule above
# silently untracked its page.mdx: the site still built locally, because the
# file was on disk, and the registry-to-disk test still passed for the same
# reason. On a fresh clone the article would simply be missing. Every real
# build output in this repo sits inside .next/, .next-dev/ or out/, all ignored
# in their own right, so this exception costs nothing.
!apps/help/app/**/build/
.next/
.next-dev/
out/
*.tsbuildinfo

# Playwright e2e artifacts (spec/72)
apps/live/test-results/
apps/live/playwright-report/
apps/live/.playwright/

# Turbo
.turbo/

# Wrangler local state (Miniflare D1 / Durable Object simulation cache)
.wrangler/

# Env files
.env
.env.local
.env.*.local
# Wrangler local-dev secrets (mirrors the production secret store but
# stays on disk for `wrangler dev`). Per spec/06 these must never be
# committed.
.dev.vars

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Test
coverage/
.nyc_output/

# Claude Code harness state (scheduled-task locks, worktrees,
# session metadata). Per-user, per-checkout — never source.
.claude/
