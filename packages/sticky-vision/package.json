{
  "name": "@livediagram/sticky-vision",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./png": "./scripts/png.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "clean": "rm -rf node_modules .turbo",
    "truth:add": "tsx scripts/truth-add.ts"
  },
  "dependencies": {
    "@livediagram/document": "workspace:*"
  },
  "devDependencies": {
    "@livediagram/oxlint-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
