{
  "name": "@liveworkspace/help-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./apps": "./src/apps.ts",
    "./hrefs": "./src/hrefs.ts",
    "./registry": "./src/registry.ts",
    "./telemetry": "./src/telemetry.ts",
    "./community": "./src/community.ts",
    "./catalogue": "./src/catalogue/index.ts",
    "./slice/*": "./src/slice/*.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "dependencies": {
    "@liveworkspace/sites": "workspace:*"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
