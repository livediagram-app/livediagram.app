{
  "name": "@liveworkspace/marketing-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./css/*": "./src/css/*"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "dependencies": {
    "@liveworkspace/auth-client": "workspace:^",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/licences": "workspace:*",
    "@liveworkspace/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/style-guards": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
