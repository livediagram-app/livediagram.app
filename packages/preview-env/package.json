{
  "name": "@livediagram/preview-env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "config": "node scripts/config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage",
    "staging:check": "node scripts/check.ts"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
