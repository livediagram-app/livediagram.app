{
  "name": "@liveworkspace/licences",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/contract.ts",
  "types": "./src/contract.ts",
  "exports": {
    ".": "./src/contract.ts",
    "./contract": "./src/contract.ts",
    "./tables": "./src/tables.ts",
    "./texts": "./src/texts.ts",
    "./licence-id": "./src/licence-id.ts",
    "./generate": "./scripts/generate.ts",
    "./declared": "./src/declared.ts",
    "./product-checks": "./src/product-checks.ts"
  },
  "scripts": {
    "verify": "node scripts/verify.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
