{
  "name": "@liveworkspace/vitest-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "vitest-budgets": "./budgets.js"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./react-cleanup": "./react-cleanup.js",
    "./cpu-time": {
      "types": "./cpu-time.d.ts",
      "default": "./cpu-time.js"
    },
    "./inline-script": {
      "types": "./inline-script.d.ts",
      "default": "./inline-script.js"
    },
    "./sent-request": {
      "types": "./sent-request.d.ts",
      "default": "./sent-request.js"
    },
    "./axe": {
      "types": "./axe.d.ts",
      "default": "./axe.js"
    },
    "./workspace-manifests": {
      "types": "./workspace-manifests.d.ts",
      "default": "./workspace-manifests.js"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.3.3",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "axe-core": "4.10.3"
  }
}
