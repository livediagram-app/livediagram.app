{
  "name": "@liveworkspace/api-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api-token": "./src/api-token.ts",
    "./bytes": "./src/bytes.ts",
    "./client-ip": "./src/client-ip.ts",
    "./oauth": "./src/oauth.ts",
    "./request-auth": "./src/request-auth.ts",
    "./request-body": "./src/request-body.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "dependencies": {
    "@liveworkspace/sites": "workspace:*"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
