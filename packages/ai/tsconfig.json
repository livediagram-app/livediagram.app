{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for the Web APIs the package runs on in a Worker and in Node alike (`fetch`, streams, AbortController).
    // `node` for the tests alone; the source touches none of it.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
