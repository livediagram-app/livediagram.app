{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    // The guards read the four help apps from disk.
    "types": ["node"],
    "allowJs": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts", "next-config.js", "next-config.d.ts"],
  "exclude": ["node_modules"]
}
