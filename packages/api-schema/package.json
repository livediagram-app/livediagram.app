{
  "name": "@liveplanner/api-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@liveplanner/document": "workspace:*",
    "@liveplanner/forms": "workspace:*",
    "@liveplanner/items": "workspace:*",
    "@liveplanner/sheets": "workspace:*"
  },
  "devDependencies": {
    "@liveplanner/oxlint-config": "workspace:*",
    "@liveplanner/vitest-config": "workspace:*",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
