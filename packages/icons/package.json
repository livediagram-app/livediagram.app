{
  "name": "@livediagram/icons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./icon-catalog-1": "./src/icon-catalog-1.ts",
    "./icon-catalog-2": "./src/icon-catalog-2.ts",
