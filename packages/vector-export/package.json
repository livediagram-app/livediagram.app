{
  "name": "@liveworkspace/vector-export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./pdf": "./src/pdf/index.ts",
    "./pdf-links": "./src/pdf/pdf-links.ts",
    "./pdf-page-size": "./src/pdf/pdf-page-size.ts",
    "./outline-svg": "./src/outline-text/outline-svg.ts",
    "./outline-error": "./src/outline-text/outline-error.ts",
    "./lazy-guard": "./src/lazy-guard.ts"
  },
  "imports": {
    "#fontkit": {
      "types": "./src/outline-text/fontkit-module.d.ts",
      "default": "fontkit"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@liveworkspace/trusted-types": "workspace:*",
    "fontkit": "3.0.0"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
