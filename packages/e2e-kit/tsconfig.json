{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The helpers run under Playwright, and parts of them inside the page (page.evaluate), so both the
    // DOM and Node are in reach.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
