{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // negotiate.ts runs in Workers (fetch, Request, Response); the build runs under Node type stripping, which
    // needs explicit .ts imports.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
