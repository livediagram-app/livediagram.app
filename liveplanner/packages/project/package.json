{
  "name": "@liveplanner/project",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@liveplanner/forms": "workspace:*",
    "@liveplanner/items": "workspace:*",
    "@liveworkspace/document-core": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/page-background": "workspace:*",
    "perfect-freehand": "^1.2.3"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "stroke-points": "node --import ../../scripts/ts-source-hooks.mjs scripts/expand-stroke-points.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage"
  },
  "devDependencies": {
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
