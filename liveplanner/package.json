{
  "name": "liveplanner",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@liveplanner/*",
    "dev": "turbo run dev --filter=@liveplanner/*",
    "lint": "turbo run lint --filter=@liveplanner/*",
    "test": "turbo run test --filter=@liveplanner/*",
    "test:coverage": "turbo run test:coverage --filter=@liveplanner/*",
    "typecheck": "turbo run typecheck --filter=@liveplanner/*",
    "staging:check": "turbo run staging:check --filter=@liveplanner/*",
    "licences": "pnpm --filter @liveplanner/marketing licences",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean --filter=@liveplanner/* && rm -rf node_modules",
    "icons:vendor": "pnpm --filter @liveplanner/icons vendor:lucide",
    "icons:sheet": "pnpm --filter @liveplanner/editor icons:sheet",
    "icons:brand": "pnpm --filter @liveplanner/editor icons:brand"
  },
  "devDependencies": {
    "@liveplanner/oxlint-config": "workspace:*",
    "@liveplanner/prettier-config": "workspace:*",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
