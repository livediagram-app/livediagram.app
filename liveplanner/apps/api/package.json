{
  "name": "@liveplanner/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var GUEST_SIG_ENFORCE_AFTER:",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "node scripts/gen-openapi-schemas.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage",
    "db:migrate:local": "wrangler d1 migrations apply liveplanner --local",
    "db:migrate:remote": "wrangler d1 migrations apply liveplanner --remote"
  },
  "dependencies": {
    "@liveplanner/api-schema": "workspace:*",
    "@liveplanner/project": "workspace:*",
    "@liveplanner/project-views": "workspace:*",
    "@liveplanner/edit-operations": "workspace:*",
    "@liveplanner/forms": "workspace:*",
    "@liveplanner/icons": "workspace:*",
    "@liveplanner/items": "workspace:*",
    "@liveplanner/plan-art": "workspace:*",
    "@liveplanner/render-png": "workspace:*",
    "@liveplanner/sheets": "workspace:*",
    "@liveplanner/templates": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@liveplanner/oxlint-config": "workspace:*",
    "@liveplanner/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.88.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
