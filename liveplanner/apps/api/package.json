{
  "name": "@liveplanner/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node ../../../packages/api-kit/scripts/dev-vars.ts --after ../../../liveworkspace/apps/accounts/.dev.vars && wrangler dev --inspector-port 9332",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && vitest-budgets",
    "gen:openapi": "node scripts/gen-openapi-schemas.mjs",
    "github:hooks": "node scripts/refresh-github-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo coverage"
  },
  "dependencies": {
    "@liveplanner/api-schema": "workspace:*",
    "@liveplanner/edit-operations": "workspace:*",
    "@liveplanner/forms": "workspace:*",
    "@liveplanner/items": "workspace:*",
    "@liveplanner/plan-art": "workspace:*",
    "@liveplanner/project": "workspace:*",
    "@liveplanner/project-views": "workspace:*",
    "@liveplanner/sheets": "workspace:*",
    "@liveplanner/templates": "workspace:*",
    "@liveworkspace/api-kit": "workspace:*",
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/community": "workspace:^",
    "@liveworkspace/drive": "workspace:*",
    "@liveworkspace/email": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/index-app": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:*",
    "@liveworkspace/migration": "workspace:*",
    "@liveworkspace/model-core": "workspace:^",
    "@liveworkspace/settings": "workspace:*",
    "@liveworkspace/sites": "workspace:*",
    "@liveworkspace/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@liveworkspace/community-service": "workspace:^",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.90.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
