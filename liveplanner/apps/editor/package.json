{
  "name": "@liveplanner/editor",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node ../../../packages/next-config/scripts/next-dev.mjs --port 3202",
    "dev:webpack": "node ../../../packages/next-config/scripts/next-dev.mjs --port 3202 --webpack",
    "build": "next build && asset-size-gate out",
    "build:signed-in": "node ../../../packages/next-config/scripts/build-signed-in.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && vitest-budgets",
    "test:e2e": "playwright test --project=chromium --project=sites",
    "test:e2e:smoke": "playwright test --project=chromium",
    "test:e2e:sites": "playwright test --project=sites",
    "perf:canvas": "E2E_PERF=1 playwright test --project=perf --reporter=line",
    "test:e2e:signed-in": "E2E_SIGNED_IN=1 playwright test --project=signed-in",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-dev .next-analyze out node_modules .turbo coverage",
    "icons:sheet": "vitest run --config scripts/icon-sheet/vitest.config.ts && node ../../../packages/e2e-kit/scripts/icon-sheet-shoot.mjs",
    "icons:brand": "node scripts/brand-icons/render.mjs",
    "test:e2e:workbench": "NEXT_PUBLIC_E2E_AUTH=1 next build && E2E_WORKBENCH=1 playwright test --project=workbench"
  },
  "dependencies": {
    "@liveplanner/api-schema": "workspace:*",
    "@liveplanner/forms": "workspace:*",
    "@liveplanner/help-registry": "workspace:*",
    "@liveplanner/items": "workspace:*",
    "@liveplanner/plan-art": "workspace:*",
    "@liveplanner/project": "workspace:*",
    "@liveplanner/project-views": "workspace:*",
    "@liveplanner/sheets": "workspace:*",
    "@liveplanner/telemetry-client": "workspace:*",
    "@liveplanner/template-previews": "workspace:*",
    "@liveplanner/templates": "workspace:*",
    "@liveplanner/ui": "workspace:*",
    "@liveworkspace/api-schema": "workspace:*",
    "@liveworkspace/auth-client": "workspace:*",
    "@liveworkspace/community-ui": "workspace:^",
    "@liveworkspace/explorer": "workspace:*",
    "@liveworkspace/icons": "workspace:*",
    "@liveworkspace/index-client": "workspace:*",
    "@liveworkspace/media": "workspace:*",
    "@liveworkspace/model-core": "workspace:*",
    "@liveworkspace/page-background": "workspace:*",
    "@liveworkspace/settings": "workspace:*",
    "@liveworkspace/settings-ui": "workspace:*",
    "@liveworkspace/sites": "workspace:*",
    "@liveworkspace/style-guards": "workspace:*",
    "@liveworkspace/telemetry-client": "workspace:*",
    "@liveworkspace/trusted-types": "workspace:*",
    "@liveworkspace/ui": "workspace:*",
    "@liveworkspace/workbench": "workspace:*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@liveplanner/tailwind-config": "workspace:*",
    "@liveworkspace/e2e-kit": "workspace:*",
    "@liveworkspace/next-config": "workspace:*",
    "@liveworkspace/oxlint-config": "workspace:*",
    "@liveworkspace/source-ast": "workspace:*",
    "@liveworkspace/vitest-config": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
