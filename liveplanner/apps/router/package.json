{
  "name": "@liveplanner/router",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "staging:check": "wrangler deploy --dry-run --env staging",
    "dev": "wrangler dev --env local --port 3100 --inspector-port 9331",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler node_modules .turbo"
  },
  "dependencies": {
    "@liveworkspace/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@liveplanner/api-schema": "workspace:*",
    "@liveplanner/help-registry": "workspace:*",
    "@liveplanner/oxlint-config": "workspace:*",
    "@liveplanner/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
