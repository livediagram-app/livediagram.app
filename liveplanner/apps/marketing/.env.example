# Marketing site environment variables.
#
# This app is a static export. Anything prefixed NEXT_PUBLIC_ is baked into
# the build and shipped to the browser, where anyone can read it (docs/specs/002-project-scope/secrets-policy.md), so
# never put secrets here.

# Where the page-view counter (docs/specs/017-telemetry/page-view-telemetry.md) sends its events. In production the
# router stitches the api worker onto the same hostname under `/api/*`, so
# leaving this unset is correct (it falls back to the origin-relative '/api').
# For local development point it at a `wrangler dev` of @liveplanner/api:
#     NEXT_PUBLIC_API_BASE=http://localhost:8887/api
NEXT_PUBLIC_API_BASE=

# Anonymous, first-party usage telemetry switch (docs/specs/017-telemetry/telemetry.md). The marketing
# site's ONLY event is the page view (docs/specs/017-telemetry/page-view-telemetry.md). When set to the literal
# string "true" it is POSTed to liveworkspace's central telemetry service; anything else (including
# unset) sends nothing, so a deployment without it configured is OFF. Pair with
# `TELEMETRY_ENABLED=true` on the api worker.
NEXT_PUBLIC_TELEMETRY_ENABLED=

# Where the events go: liveworkspace's central telemetry service
# (liveworkspace/docs/specs/008-telemetry/telemetry.md). Unset is production's,
# https://www.liveworkspace.app/api/telemetry. For local development point it at a
# `wrangler dev` of liveworkspace/apps/telemetry:
#     NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8790/api/telemetry
NEXT_PUBLIC_TELEMETRY_URL=

# The MCP worker the Build with AI page (/ai) tells AI tools to connect to
# (docs/specs/019-marketing/build-with-ai.md). Unset or blank is the hosted one,
# https://mcp.liveplanner.app; another deployment (staging, local) sets its own origin here,
# the same value the live app's NEXT_PUBLIC_MCP_ORIGIN takes.
NEXT_PUBLIC_MCP_ORIGIN=
