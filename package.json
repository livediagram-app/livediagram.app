{
  "name": "livediagram",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "staging:check": "turbo run staging:check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@livediagram/eslint-config": "workspace:*",
    "@livediagram/prettier-config": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "undici": "^7.28.0",
      "js-yaml": "^4.3.0",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.5",
      "@hono/node-server": "^2.0.5",
      "ws": "^8.21.0",
      "sharp": "^0.35.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@3 || 4 || 5": "^5.0.8"
    }
  }
}
