{
  "name": "liveplanner",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "node scripts/git-hooks/install.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "staging:check": "turbo run staging:check",
    "licences": "pnpm --filter @liveplanner/marketing licences",
    "bench:stroke-points": "node --expose-gc --import ./scripts/ts-source-hooks.mjs scripts/stroke-points-bench.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "icons:vendor": "pnpm --filter @liveplanner/icons vendor:lucide",
    "icons:sheet": "pnpm --filter @liveplanner/live icons:sheet",
    "icons:brand": "pnpm --filter @liveplanner/live icons:brand"
  },
  "devDependencies": {
    "@liveplanner/oxlint-config": "workspace:*",
    "@liveplanner/prettier-config": "workspace:*",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "undici": "^7.28.0",
      "js-yaml": "^4.3.0",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.6",
      "qs": "^6.16.0",
      "nanoid": "^3.3.18",
      "vitest": "^5.0.1",
      "@hono/node-server": "^2.0.5",
      "ws": "^8.21.0",
      "sharp": "^0.35.5",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@3 || 4 || 5": "^5.0.8"
    }
  }
}
