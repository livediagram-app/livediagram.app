{
  "name": "liveworkspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "staging:check": "turbo run staging:check",
    "dev:diagram": "turbo run dev --filter=@livediagram/*",
    "dev:planner": "turbo run dev --filter=@liveplanner/*",
    "dev:pages": "turbo run dev --filter=@livepages/*",
    "dev:accounts": "turbo run dev --filter=@liveworkspace/accounts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "undici": "^7.28.0",
      "js-yaml": "^4.3.0",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.6",
      "qs": "^6.16.0",
      "nanoid": "^3.3.18",
      "vitest": "^5.0.1",
      "@hono/node-server": "^2.0.5",
      "ws": "^8.21.0",
      "sharp": "^0.35.5",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@3 || 4 || 5": "^5.0.8",
      "onnxruntime-node>global-agent": "^4.1.3",
      "@tensorflow/tfjs>argparse": "^2.0.1"
    }
  }
}
